VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=Xây POS
VITE_ENABLE_QR_API=true
VITE_REALTIME_ENABLED=true
# Optional override; otherwise derived from VITE_API_BASE_URL (including context path).
VITE_REALTIME_URL=ws://localhost:8080/ws
# Cloudflare Turnstile site key for the registration CAPTCHA (public, baked into the bundle).
# 1x00000000000000000000AA is Cloudflare's test key: always passes, works on localhost. Pair it with the backend
# test secret 1x0000000000000000000000000000000AA. Leave empty to register without a CAPTCHA.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
